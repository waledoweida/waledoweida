{
  "name": "waledoweida-site",
  "private": true,
  "description": "Static site + serverless functions in api/ (Vercel, TypeScript).",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "redis": "4.7.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test tests/api.test.js",
    "lint:html": "html-validate \"**/*.html\"",
    "check": "npm run typecheck && npm test && npm run lint:html"
  },
  "devDependencies": {
    "@types/node": "20.16.11",
    "html-validate": "8.24.1",
    "terser": "5.36.0",
    "typescript": "5.6.3"
  }
}
