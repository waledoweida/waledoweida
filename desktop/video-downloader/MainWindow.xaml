<Window x:Class="VideoDownloader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تنزيل الفيديوهات - تصميم المهندس وليد أبوعويضة"
        Width="1080" Height="740" MinWidth="860" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource Ink}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="13.5"
        FlowDirection="RightToLeft" AllowDrop="True"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        Icon="pack://application:,,,/app.ico">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Window.TaskbarItemInfo>
    <TaskbarItemInfo x:Name="Taskbar"/>
  </Window.TaskbarItemInfo>

  <Border x:Name="WindowFrame" Background="{StaticResource Ink}" BorderBrush="{StaticResource Line}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="52"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- soft gold glow -->
      <Ellipse Grid.RowSpan="3" Width="760" Height="420" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-200,-220,0,0" IsHitTestVisible="False">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="#24E6C983" Offset="0"/>
            <GradientStop Color="#00E6C983" Offset="1"/>
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>

      <!-- title bar -->
      <Grid Grid.Row="0" Margin="16,0,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="pack://application:,,,/logo.png" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality"/>
          <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="تنزيل الفيديوهات" FontSize="14.5" FontWeight="Bold"/>
            <TextBlock Text="تصميم المهندس وليد أبوعويضة" FontSize="11" Foreground="{StaticResource Gold}" Margin="0,-1,0,0"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" FlowDirection="LeftToRight">
          <Button x:Name="MinBtn" Style="{StaticResource CaptionButton}" Content="&#xE921;" WindowChrome.IsHitTestVisibleInChrome="True" Click="Min_Click" ToolTip="تصغير"/>
          <Button x:Name="MaxBtn" Style="{StaticResource CaptionButton}" Content="&#xE922;" WindowChrome.IsHitTestVisibleInChrome="True" Click="Max_Click" ToolTip="تكبير"/>
          <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click" ToolTip="إغلاق"/>
        </StackPanel>
      </Grid>

      <!-- main -->
      <Grid Grid.Row="1" Margin="24,6,24,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="440"/>
          <ColumnDefinition Width="22"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- left (start) column: link, preview, options -->
        <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
          <StackPanel>
            <TextBlock FontSize="25" FontWeight="Bold" TextWrapping="Wrap" LineHeight="36">
              <Run Text="حمّل أي فيديو"/>
              <Run Text="بالجودة اللي تعجبك" Foreground="{StaticResource Gold}"/>
            </TextBlock>
            <TextBlock Text="يوتيوب • تيك توك • إنستجرام • فيسبوك • X • وأكتر من 1000 موقع" Foreground="{StaticResource Muted}" FontSize="12.5" Margin="0,4,0,0" TextWrapping="Wrap"/>
            <Border Background="{StaticResource GreenSoft}" BorderBrush="#4D1FA855" BorderThickness="1" CornerRadius="99" Padding="10,4" HorizontalAlignment="Left" Margin="0,12,0,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xEA18;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{StaticResource Green}" VerticalAlignment="Center"/>
                <TextBlock Text="مجاني وآمن 100%" FontSize="12" FontWeight="SemiBold" Foreground="#5FD38D" Margin="7,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>

            <!-- link box -->
            <Border x:Name="UrlFrame" Margin="0,18,0,0" Background="{StaticResource Ink2}" BorderBrush="{StaticResource Line}" BorderThickness="1.5" CornerRadius="14" Padding="14,6,6,6">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE71B;" FontFamily="{StaticResource Icons}" FontSize="15" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                <TextBox x:Name="UrlBox" Grid.Column="1" Style="{StaticResource UrlBox}" Margin="10,0,8,0" FlowDirection="LeftToRight"
                         Tag="الصق لينك الفيديو هنا…" KeyDown="UrlBox_KeyDown" TextChanged="UrlBox_TextChanged"
                         GotKeyboardFocus="UrlBox_Focus" LostKeyboardFocus="UrlBox_Focus"/>
                <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE77F;" ToolTip="لصق" Click="Paste_Click"/>
                <Button x:Name="FetchBtn" Grid.Column="3" Style="{StaticResource GhostButton}" Margin="4,0,0,0" Click="Fetch_Click" Padding="14,9">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Text="عرض" Margin="7,0,0,0"/>
                  </StackPanel>
                </Button>
              </Grid>
            </Border>

            <!-- loading / error -->
            <StackPanel x:Name="Loading" Margin="2,12,2,0" Visibility="Collapsed">
              <TextBlock Text="بنجيب بيانات الفيديو…" Foreground="{StaticResource Muted}" FontSize="12.5"/>
              <ProgressBar Style="{StaticResource Bar}" IsIndeterminate="True" Height="4" Margin="0,8,0,0"/>
            </StackPanel>
            <Border x:Name="ErrorBox" Margin="0,12,0,0" Background="{StaticResource RedSoft}" BorderBrush="#59E5484D" BorderThickness="1" CornerRadius="12" Padding="12,10" Visibility="Collapsed">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE783;" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Red}" VerticalAlignment="Top" Margin="0,3,0,0"/>
                <TextBlock x:Name="ErrorText" Foreground="#FFB4B6" TextWrapping="Wrap" Margin="9,0,0,0" MaxWidth="380"/>
              </StackPanel>
            </Border>

            <!-- preview -->
            <Border x:Name="Preview" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="12" Visibility="Collapsed">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="148"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border CornerRadius="10" Height="84" Background="{StaticResource Ink3}" VerticalAlignment="Top">
                  <Grid>
                    <TextBlock Text="&#xE714;" FontFamily="{StaticResource Icons}" FontSize="22" Foreground="{StaticResource Faint}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Border CornerRadius="10">
                      <Border.Background>
                        <ImageBrush x:Name="PreviewThumb" Stretch="UniformToFill"/>
                      </Border.Background>
                    </Border>
                    <Border x:Name="DurationBadge" Background="#D90B0D12" CornerRadius="6" Padding="6,1" Margin="6" HorizontalAlignment="Right" VerticalAlignment="Bottom" FlowDirection="LeftToRight">
                      <TextBlock x:Name="DurationText" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                  </Grid>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                  <Border Background="{StaticResource GoldSoft}" CornerRadius="99" Padding="8,1" HorizontalAlignment="Left">
                    <TextBlock x:Name="SiteText" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Gold}"/>
                  </Border>
                  <TextBlock x:Name="TitleText" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" MaxHeight="42" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" LineHeight="21"/>
                  <TextBlock x:Name="UploaderText" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                </StackPanel>
                <CheckBox x:Name="PlaylistCheck" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Check}" Margin="2,12,0,0" Visibility="Collapsed">
                  <TextBlock x:Name="PlaylistText" Text="حمّل قائمة التشغيل كلها"/>
                </CheckBox>
              </Grid>
            </Border>

            <!-- options -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,2">
              <StackPanel>
                <Border Background="{StaticResource Ink}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="4">
                  <UniformGrid Columns="2">
                    <RadioButton x:Name="VideoMode" Style="{StaticResource SegRadio}" GroupName="mode" IsChecked="True" Checked="Mode_Changed">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE714;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center"/>
                        <TextBlock Text="فيديو" Margin="8,0,0,0"/>
                      </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="AudioMode" Style="{StaticResource SegRadio}" GroupName="mode" Checked="Mode_Changed">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center"/>
                        <TextBlock Text="صوت بس (MP3)" Margin="8,0,0,0"/>
                      </StackPanel>
                    </RadioButton>
                  </UniformGrid>
                </Border>

                <StackPanel x:Name="VideoOpts" Margin="0,16,0,0">
                  <TextBlock Text="الجودة" Style="{StaticResource Label}"/>
                  <ComboBox x:Name="QualityBox" Style="{StaticResource Combo}" SelectionChanged="Quality_Changed">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding Text}"/>
                          <TextBlock Text="{Binding Hint}" Foreground="{StaticResource Muted}" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <CheckBox x:Name="CompatCheck" Style="{StaticResource Check}" Margin="0,14,0,0" IsChecked="True" Click="Compat_Click">
                    <StackPanel>
                      <TextBlock Text="ملف MP4 يشتغل على أي جهاز"/>
                      <TextBlock Text="موبايل، تلفزيون، أو أي برنامج تشغيل" Foreground="{StaticResource Muted}" FontSize="11.5"/>
                    </StackPanel>
                  </CheckBox>
                </StackPanel>

                <StackPanel x:Name="AudioOpts" Margin="0,16,0,0" Visibility="Collapsed">
                  <TextBlock Text="جودة الصوت" Style="{StaticResource Label}"/>
                  <ComboBox x:Name="AudioBox" Style="{StaticResource Combo}" SelectionChanged="Audio_Changed">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding Text}"/>
                          <TextBlock Text="{Binding Hint}" Foreground="{StaticResource Muted}" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>

                <TextBlock Text="مكان الحفظ" Style="{StaticResource Label}" Margin="0,16,0,8"/>
                <Border Background="{StaticResource Ink}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="12,4,4,4">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Gold}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="FolderText" Grid.Column="1" Margin="10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FlowDirection="LeftToRight" TextAlignment="Right" FontSize="12.5"/>
                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="تغيير" Padding="12,6" Click="Folder_Click"/>
                  </Grid>
                </Border>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>
        <Button x:Name="DownloadBtn" Grid.Row="1" Style="{StaticResource GoldButton}" Margin="0,14,6,4" Padding="22,14" Click="Download_Click" IsEnabled="False">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE896;" FontFamily="{StaticResource Icons}" FontSize="16" VerticalAlignment="Center"/>
            <TextBlock Text="تنزيل" FontSize="16" Margin="10,0,0,0"/>
          </StackPanel>
        </Button>
        </Grid>

        <!-- right (end) column: downloads -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Margin="18,14,14,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="التنزيلات" FontSize="16" FontWeight="Bold"/>
                <Border Background="{StaticResource Ink4}" CornerRadius="99" Padding="9,1" Margin="10,0,0,0" VerticalAlignment="Center">
                  <TextBlock x:Name="CountText" Text="0" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
                </Border>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource GhostButton}" Padding="12,7" Click="OpenFolder_Click">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE838;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Text="فتح الفولدر" Margin="7,0,0,0"/>
                  </StackPanel>
                </Button>
                <Button x:Name="ClearBtn" Style="{StaticResource GhostButton}" Padding="12,7" Margin="8,0,0,0" Click="Clear_Click" Content="مسح المنتهي"/>
              </StackPanel>
            </Grid>
            <Border Grid.Row="0" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" VerticalAlignment="Bottom"/>

            <!-- empty state -->
            <StackPanel x:Name="EmptyState" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
              <Border Width="76" Height="76" CornerRadius="38" Background="{StaticResource GoldSoft}" HorizontalAlignment="Center">
                <TextBlock Text="&#xE896;" FontFamily="{StaticResource Icons}" FontSize="30" Foreground="{StaticResource Gold}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock Text="لسه مفيش تنزيلات" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,0"/>
              <TextBlock Text="انسخ لينك أي فيديو، والبرنامج هيلاحظه لوحده." Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
              <TextBlock Text="أو اسحب اللينك وارميه هنا." Foreground="{StaticResource Faint}" HorizontalAlignment="Center" Margin="0,2,0,0" FontSize="12"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,10,8,10">
              <ItemsControl x:Name="DownloadsList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{StaticResource Ink3}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="10" Margin="0,0,0,10">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="112"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border CornerRadius="9" Height="63" Background="{StaticResource Ink4}" VerticalAlignment="Top">
                          <Grid>
                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="20" Foreground="{StaticResource Faint}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border CornerRadius="9" Visibility="{Binding HasThumb, Converter={StaticResource Vis}}">
                              <Border.Background>
                                <ImageBrush ImageSource="{Binding Thumb}" Stretch="UniformToFill"/>
                              </Border.Background>
                            </Border>
                          </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                          <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock Text="{Binding Kind}" Foreground="{StaticResource Muted}" FontSize="11.5"/>
                            <TextBlock Text="  •  " Foreground="{StaticResource Faint}" FontSize="11.5" Visibility="{Binding HasPlaylistPos, Converter={StaticResource Vis}}"/>
                            <TextBlock Text="{Binding PlaylistPos}" Foreground="{StaticResource Muted}" FontSize="11.5" Visibility="{Binding HasPlaylistPos, Converter={StaticResource Vis}}"/>
                          </StackPanel>
                          <ProgressBar Style="{StaticResource Bar}" Value="{Binding Percent, Mode=OneWay}" Maximum="100" IsIndeterminate="{Binding Indeterminate, Mode=OneWay}"
                                       Margin="0,9,0,0" Visibility="{Binding ShowBar, Converter={StaticResource Vis}}"/>
                          <Grid Margin="0,6,0,0">
                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,120,0"/>
                            <TextBlock Text="{Binding Details}" Foreground="{StaticResource Muted}" FontSize="11.5" HorizontalAlignment="Right" FlowDirection="LeftToRight"/>
                          </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                          <Button Style="{StaticResource IconButton}" Content="&#xE768;" ToolTip="تشغيل" Click="ItemOpen_Click" Visibility="{Binding IsDone, Converter={StaticResource Vis}}"/>
                          <Button Style="{StaticResource IconButton}" Content="&#xE838;" ToolTip="إظهار في الفولدر" Click="ItemShow_Click" Visibility="{Binding IsDone, Converter={StaticResource Vis}}"/>
                          <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="إعادة المحاولة" Click="ItemRetry_Click" Visibility="{Binding CanRetry, Converter={StaticResource Vis}}"/>
                          <Button Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="إلغاء" Click="ItemCancel_Click" Visibility="{Binding CanCancel, Converter={StaticResource Vis}}"/>
                          <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="إزالة من القائمة" Click="ItemRemove_Click" Visibility="{Binding CanRemove, Converter={StaticResource Vis}}"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <!-- drop hint -->
            <Border x:Name="DropHint" Grid.RowSpan="2" CornerRadius="16" BorderBrush="{StaticResource Gold}" BorderThickness="2" Background="#D90B0D12" Visibility="Collapsed" IsHitTestVisible="False">
              <TextBlock Text="سيب اللينك هنا" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Gold}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </Grid>
        </Border>
      </Grid>

      <!-- footer -->
      <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="24,10" Background="#80070809">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="تصميم المهندس وليد أبوعويضة" FontSize="12" FontWeight="SemiBold"/>
            <TextBlock Text="  •  " Foreground="{StaticResource Faint}" FontSize="12"/>
            <Button Style="{StaticResource LinkButton}" Content="waledoweida.com" Click="Site_Click"/>
            <TextBlock Text="  •  " Foreground="{StaticResource Faint}" FontSize="12"/>
            <TextBlock Text="مجاني وآمن 100%" FontSize="12" Foreground="#5FD38D"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="ToolsText" Foreground="{StaticResource Faint}" FontSize="11.5" VerticalAlignment="Center" FlowDirection="LeftToRight"/>
            <Button x:Name="UpdateBtn" Style="{StaticResource LinkButton}" Margin="12,0,0,0" Click="Update_Click">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE895;" FontFamily="{StaticResource Icons}" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock x:Name="UpdateText" Text="تحديث الأدوات" Margin="6,0,0,0"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- toast -->
      <Border x:Name="Toast" Grid.Row="1" Grid.RowSpan="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,58"
              Background="{StaticResource Ink3}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="16,10" Visibility="Collapsed" IsHitTestVisible="False">
        <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.45" Direction="270"/></Border.Effect>
        <StackPanel Orientation="Horizontal">
          <TextBlock x:Name="ToastIcon" Text="&#xE73E;" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Green}" VerticalAlignment="Center"/>
          <TextBlock x:Name="ToastText" Margin="10,0,0,0" FontWeight="SemiBold"/>
        </StackPanel>
      </Border>

      <!-- first-run setup -->
      <Grid x:Name="SetupLayer" Grid.Row="1" Grid.RowSpan="2" Background="{StaticResource Ink}" Visibility="Collapsed">
        <Border Style="{StaticResource Card}" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32,30">
          <StackPanel>
            <Image Source="pack://application:,,,/logo.png" Width="72" Height="72" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="أهلاً بيك 👋" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,16,0,0"/>
            <TextBlock x:Name="SetupTitle" Text="بنجهّز البرنامج لأول مرة" FontSize="15" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            <TextBlock Text="بنحمّل أدوات التنزيل المجانية مرة واحدة بس (حوالي 200 ميجا). بعد كده البرنامج بيفتح على طول."
                       Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" LineHeight="21"/>
            <ProgressBar x:Name="SetupBar" Style="{StaticResource Bar}" Height="8" Maximum="100" Margin="0,22,0,0"/>
            <Grid Margin="0,9,0,0">
              <TextBlock x:Name="SetupStep" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,50,0"/>
              <TextBlock x:Name="SetupPct" Foreground="{StaticResource Gold}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" FlowDirection="LeftToRight"/>
            </Grid>
            <Button x:Name="SetupRetry" Style="{StaticResource GoldButton}" Content="حاول تاني" Margin="0,18,0,0" Visibility="Collapsed" Click="SetupRetry_Click"/>
            <TextBlock Text="تصميم المهندس وليد أبوعويضة • مجاني وآمن 100%" Foreground="{StaticResource Faint}" FontSize="11.5" HorizontalAlignment="Center" Margin="0,22,0,0"/>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
